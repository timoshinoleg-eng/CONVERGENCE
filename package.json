{
  "name": "convergence",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --testTimeout=30000",
    "test:pacing": "vitest run src/game/balance/pacing.spec.ts",
    "build": "npm run typecheck && vite build",
    "check": "npm run typecheck && npm run test && npm run build",
    "cap:sync": "cap sync",
    "cap:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@idlekitjs/economy": "0.1.1",
    "@yggdrasil-forge/core": "1.0.0",
    "inkjs": "2.4.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
